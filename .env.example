# Port et interface exposes sur le VPS
APP_BIND=0.0.0.0
APP_PORT=3000

# URL publique, utilisee dans les liens magiques et les emails
APP_URL=http://localhost:3000

# Postgres (interne au reseau Docker, non expose)
POSTGRES_USER=onbo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=onbo
DATABASE_URL=postgresql://onbo:change-me@db:5432/onbo?schema=public

# Chiffrement des acces client (AES-256-GCM), 32 octets en base64 :
#   openssl rand -base64 32
ONBO_ENCRYPTION_KEY=

# Secret partage entre le service cron et /api/cron/reminders :
#   openssl rand -hex 24
CRON_SECRET=
