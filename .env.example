# ─────────────────────────────────────────────────────────────
# Onbo — variables d'environnement
# Obligatoire : DATABASE_URL, DIRECT_DATABASE_URL, ONBO_ENCRYPTION_KEY
# Le reste a des valeurs par defaut utilisables.
# ─────────────────────────────────────────────────────────────

# URL publique, utilisee dans les liens magiques et les emails
APP_URL=http://localhost:3000
# Sous-domaine des portails clients (issue #30), facultatif
PORTAL_URL=

# Domaine et proxy (issue #30)
DOMAIN=app.exemple.fr
PORTAL_DOMAIN=portail.exemple.fr
ACME_EMAIL=technique@exemple.fr

# Postgres (interne au reseau Docker, non expose)
POSTGRES_USER=onbo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=onbo
DATABASE_URL=postgresql://onbo:change-me@db:5432/onbo?schema=public
# Connexion directe, utilisee par les migrations. Identique a DATABASE_URL
# hors preproduction (ou un pooler s'intercale).
DIRECT_DATABASE_URL=postgresql://onbo:change-me@db:5432/onbo?schema=public

# Chiffrement des acces client (AES-256-GCM), 32 octets en base64 :
#   openssl rand -base64 32
ONBO_ENCRYPTION_KEY=
# Rotation (issue #33) : trousseau "k0:...,k1:..." et cle d'ecriture
ONBO_ENCRYPTION_KEYS=
ONBO_ENCRYPTION_KEY_ID=

# Secret partage avec les taches planifiees :
#   openssl rand -hex 24
CRON_SECRET=

# Emails (issue #29) : console | brevo | postmark | scaleway
EMAIL_PROVIDER=console
EMAIL_FROM=Onbo <onboarding@localhost>
EMAIL_WEBHOOK_SECRET=
BREVO_API_KEY=
POSTMARK_TOKEN=
SCALEWAY_SECRET_KEY=
SCALEWAY_PROJECT_ID=

# Stockage objet (issue #32) : sans ces variables, volume disque
S3_ENDPOINT=
S3_REGION=fr-par
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
ANTIVIRUS_URL=

# Quotas de volume (issue #34), en octets
QUOTA_PROJECT_BYTES=
QUOTA_AGENCY_BYTES=

# Observabilite (issue #35)
SENTRY_DSN=
LOG_LEVEL=info
METRICS_TOKEN=
APP_RELEASE=
ALERT_WEBHOOK_URL=

# Sauvegardes (issue #31) — bucket distinct du serveur
BACKUP_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=fr-par
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=30

# Retention (issue #45)
RETENTION_PROJECT_MONTHS=12
RETENTION_LOG_DAYS=365
RETENTION_EMAIL_DAYS=180
RETENTION_ABUSE_DAYS=90

# Facturation Stripe (issue #41)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_AGENCE=
