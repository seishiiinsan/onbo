generator client {
  provider = "prisma-client-js"
  // relationJoins : Prisma resout les include en une seule requete SQL au
  // lieu d'une par relation. Determinant quand la base est distante.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Connexion directe pour les migrations : en preproduction, DATABASE_URL
  // passe par un pooler (PgBouncer) qui ne sait pas jouer du DDL. Sur le
  // serveur, les deux pointent vers la meme base.
  directUrl = env("DIRECT_DATABASE_URL")
}

/// Role dans l'agence.
/// OWNER et ADMIN (directeur de projet) voient tout l'espace ; MEMBER ne voit
/// que les projets ou il est explicitement affecte.
enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

/// Role sur un projet donne, pour les membres affectes.
enum ProjectRole {
  LEAD
  CONTRIBUTOR
  VIEWER
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum StepStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  VALIDATED
}

enum StepKind {
  ASSETS
  ACCESS
  BRIEF
  CONTENT
  OTHER
}

/// Tenant payant.
model Agency {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  accentColor String   @default("#2f6bff")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships  Membership[]
  projects     Project[]
  subscription Subscription?
}

/// Staff agence.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  sessions       Session[]
  projectMembers ProjectMember[]
  notifications  Notification[]
}

/// Lien magique a usage unique (connexion staff).
model LoginToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

/// Session staff (cookie httpOnly).
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Membership {
  id       String         @id @default(cuid())
  role     MembershipRole @default(MEMBER)
  userId   String
  agencyId String
  joinedAt DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([userId, agencyId])
  @@index([agencyId])
}

/// Identite portable : un email global, N espaces agence.
model Client {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects ClientProject[]
}

/// Un onboarding / un site, appartient a une agence.
model Project {
  id               String        @id @default(cuid())
  name             String
  status           ProjectStatus @default(DRAFT)
  agencyId         String
  /// Relances automatiques : desactivables par projet.
  remindersEnabled Boolean       @default(true)
  /// Nombre de jours sans mouvement avant relance.
  reminderDays     Int           @default(3)
  /// Garde-fou anti-spam : une relance par projet et par fenetre.
  lastReminderAt   DateTime?
  /// Echeance annoncee au client (item 10).
  dueDate          DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  agency      Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clients     ClientProject[]
  steps       OnboardingStep[]
  portalLinks PortalLink[]
  members     ProjectMember[]
  activities  Activity[]
  invites     PortalInvite[]

  @@index([agencyId])
}

/// Affectation d'un membre a un projet.
///
/// L'acces au coffre d'acces est decide affectation par affectation : un dev
/// peut travailler sur un projet sans voir les mots de passe du client.
model ProjectMember {
  id                 String      @id @default(cuid())
  userId             String
  projectId          String
  role               ProjectRole @default(CONTRIBUTOR)
  canViewCredentials Boolean     @default(false)
  createdAt          DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}

/// Lien magique donnant acces au portail d'un projet.
///
/// Le token est stocke en clair, contrairement aux sessions staff : c'est une
/// URL de partage que l'agence doit pouvoir recopier a tout moment. La
/// protection tient a l'entropie du token (32 octets) et a la revocation.
/// Revocable, regenerable, sans compte cote client (MVP, cf. issue #19).
model PortalLink {
  id         String    @id @default(cuid())
  token      String    @unique
  projectId  String
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Pivot : quel client voit quel projet.
model ClientProject {
  id        String   @id @default(cuid())
  clientId  String
  projectId String
  createdAt DateTime @default(now())

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([clientId, projectId])
  @@index([projectId])
}

enum ActivityActor {
  AGENCY
  CLIENT
  SYSTEM
}

enum CommentAuthor {
  AGENCY
  CLIENT
}

enum CredentialKind {
  HOSTING
  DOMAIN
  CMS
  SOCIAL
  ANALYTICS
  OTHER
}

/// Journal d'activite d'un projet (item 18) : qui a fait quoi, quand.
/// Alimente le fil visible cote agence et sert de trace en cas de litige.
model Activity {
  id        String        @id @default(cuid())
  projectId String
  actor     ActivityActor
  actorName String?
  action    String
  detail    String?
  createdAt DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

/// Fil de discussion d'une etape. Une note interne n'est jamais servie au portail.
model Comment {
  id         String        @id @default(cuid())
  body       String
  author     CommentAuthor
  authorName String?
  internal   Boolean       @default(false)
  stepId     String
  createdAt  DateTime      @default(now())

  step OnboardingStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
}

/// Fichier depose sur une etape. Le binaire vit hors base (volume disque).
model Asset {
  id               String   @id @default(cuid())
  filename         String
  mimeType         String
  size             Int
  storageKey       String   @unique
  uploadedByClient Boolean  @default(false)
  stepId           String
  createdAt        DateTime @default(now())

  step OnboardingStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
}

/// Acces client. Le secret est chiffre en AES-256-GCM, cle hors base.
model Credential {
  id           String         @id @default(cuid())
  label        String
  kind         CredentialKind @default(OTHER)
  username     String?
  url          String?
  secretCipher String
  secretIv     String
  secretTag    String
  /// Cle ayant chiffre ce secret (issue #33). Les secrets anterieurs a la
  /// rotation portent l'identifiant historique k0.
  keyId        String         @default("k0")
  notes        String?
  stepId       String
  createdAt    DateTime       @default(now())

  step      OnboardingStep     @relation(fields: [stepId], references: [id], onDelete: Cascade)
  accessLog CredentialAccess[]

  @@index([stepId])
  @@index([keyId])
}

/// Journal des revelations de secret : qui a lu quoi, et quand.
model CredentialAccess {
  id           String   @id @default(cuid())
  credentialId String
  userId       String
  at           DateTime @default(now())

  credential Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId])
}

model OnboardingStep {
  id          String     @id @default(cuid())
  title       String
  description String?
  kind        StepKind   @default(OTHER)
  status      StepStatus @default(PENDING)
  position    Int        @default(0)
  /// Une etape optionnelle ne pese pas dans l'avancement (item 23).
  required    Boolean    @default(true)
  /// Motif de blocage, visible aussi par le client (item 24).
  blockedNote String?
  projectId   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments    Comment[]
  assets      Asset[]
  credentials Credential[]

  @@index([projectId])
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

enum EmailCategory {
  LOGIN
  PORTAL
  REMINDER
  NOTIFICATION
  OTHER
}

/// Journal et file d'envoi des emails (issue #29).
///
/// Tout message passe par cette table : elle sert a la fois de file avec
/// reprise sur echec et de trace consultable (envoye, echoue, rebond).
model EmailMessage {
  id            String        @id @default(cuid())
  to            String
  subject       String
  text          String
  html          String?
  replyTo       String?
  category      EmailCategory @default(OTHER)
  status        EmailStatus   @default(PENDING)
  attempts      Int           @default(0)
  /// Null quand plus aucune tentative n'est prevue.
  nextAttemptAt DateTime?     @default(now())
  provider      String?
  providerId    String?
  lastError     String?
  sentAt        DateTime?
  bouncedAt     DateTime?
  bounceReason  String?
  /// Rattachements libres : pas de cle etrangere, le journal survit au projet.
  agencyId      String?
  projectId     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, nextAttemptAt])
  @@index([providerId])
  @@index([projectId])
  @@index([to])
}

/// Trace d'envoi du lien de portail au client (issue #38).
///
/// L'ouverture est deja horodatee sur PortalLink.lastUsedAt : cette table
/// repond a l'autre moitie de la question, « le lien est-il parti, quand,
/// a qui, et l'email est-il bien passe ? ».
model PortalInvite {
  id             String   @id @default(cuid())
  projectId      String
  /// Contact vise. Null si le contact a ete detache depuis.
  clientId       String?
  email          String
  portalLinkId   String?
  message        String?
  /// Ligne correspondante dans EmailMessage : statut, rebond, erreur.
  emailMessageId String?
  sentByUserId   String?
  sentAt         DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sentAt])
}

enum NotificationKind {
  STEP_SUBMITTED
  CLIENT_MESSAGE
  CLIENT_CREDENTIAL
  STEP_BLOCKED
  DAILY_DIGEST
}

/// Notification interne au staff (issue #39).
///
/// Une ligne par destinataire : l'etat lu / non lu est individuel. Le mail
/// correspondant part par la file EmailMessage, sans etre rejoue ici.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  agencyId  String
  projectId String?
  kind      NotificationKind
  title     String
  body      String?
  /// Lien interne a ouvrir au clic.
  url       String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([projectId])
}

enum AbuseKind {
  LOGIN_IP
  LOGIN_EMAIL
  PORTAL_PROBE
  PORTAL_UPLOAD
  PORTAL_MESSAGE
  PORTAL_ACTION
  QUOTA_PROJECT
  QUOTA_AGENCY
}

/// Compteur de fenetre glissante, partage par toutes les instances (issue #34).
///
/// En base plutot qu'en memoire : le compteur survit a un redemarrage et
/// reste juste si l'application tourne en plusieurs exemplaires.
model RateCounter {
  bucket      String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([bucket, windowStart])
  @@index([expiresAt])
}

/// Journal des refus, exploitable en cas d'incident (issue #34).
model AbuseEvent {
  id        String    @id @default(cuid())
  kind      AbuseKind
  /// Cle limitee, deja anonymisee cote appelant (IP hachee, email, token).
  bucket    String
  ip        String?
  email     String?
  projectId String?
  path      String?
  detail    String?
  createdAt DateTime  @default(now())

  @@index([kind, createdAt])
  @@index([createdAt])
}

/// Formules affichees sur la landing : 29 / 99 / 149 EUR par mois.
enum PlanTier {
  SOLO
  STUDIO
  AGENCE
}

/// Etat de l'abonnement, aligne sur les statuts Stripe utiles.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

/// Abonnement d'une agence (issue #41).
///
/// Une ligne par agence, creee des l'ouverture de l'espace avec l'essai de
/// 14 jours : l'agence est donc toujours dans un etat connu, meme sans carte.
/// Stripe reste la source de verite des montants ; on ne recopie ici que ce
/// dont l'application a besoin pour decider ce qui est ouvert.
model Subscription {
  id                   String             @id @default(cuid())
  agencyId             String             @unique
  plan                 PlanTier           @default(SOLO)
  status               SubscriptionStatus @default(TRIALING)
  /// Unite de facturation : nombre de sieges factures (issue #41).
  seats                Int                @default(1)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  /// Derniere relance d'essai envoyee, pour ne pas la repeter.
  trialReminderAt      DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([status])
}
