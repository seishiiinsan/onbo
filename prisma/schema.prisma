generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Role dans l'agence.
/// OWNER et ADMIN (directeur de projet) voient tout l'espace ; MEMBER ne voit
/// que les projets ou il est explicitement affecte.
enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

/// Role sur un projet donne, pour les membres affectes.
enum ProjectRole {
  LEAD
  CONTRIBUTOR
  VIEWER
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum StepStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  VALIDATED
}

enum StepKind {
  ASSETS
  ACCESS
  BRIEF
  CONTENT
  OTHER
}

/// Tenant payant.
model Agency {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  accentColor String   @default("#2f6bff")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]
  projects    Project[]
}

/// Staff agence.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  sessions       Session[]
  projectMembers ProjectMember[]
}

/// Lien magique a usage unique (connexion staff).
model LoginToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

/// Session staff (cookie httpOnly).
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Membership {
  id       String         @id @default(cuid())
  role     MembershipRole @default(MEMBER)
  userId   String
  agencyId String
  joinedAt DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([userId, agencyId])
  @@index([agencyId])
}

/// Identite portable : un email global, N espaces agence.
model Client {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects ClientProject[]
}

/// Un onboarding / un site, appartient a une agence.
model Project {
  id               String        @id @default(cuid())
  name             String
  status           ProjectStatus @default(DRAFT)
  agencyId         String
  /// Relances automatiques : desactivables par projet.
  remindersEnabled Boolean       @default(true)
  /// Nombre de jours sans mouvement avant relance.
  reminderDays     Int           @default(3)
  /// Garde-fou anti-spam : une relance par projet et par fenetre.
  lastReminderAt   DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  agency      Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clients     ClientProject[]
  steps       OnboardingStep[]
  portalLinks PortalLink[]
  members     ProjectMember[]

  @@index([agencyId])
}

/// Affectation d'un membre a un projet.
///
/// L'acces au coffre d'acces est decide affectation par affectation : un dev
/// peut travailler sur un projet sans voir les mots de passe du client.
model ProjectMember {
  id                 String      @id @default(cuid())
  userId             String
  projectId          String
  role               ProjectRole @default(CONTRIBUTOR)
  canViewCredentials Boolean     @default(false)
  createdAt          DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}

/// Lien magique donnant acces au portail d'un projet.
///
/// Le token est stocke en clair, contrairement aux sessions staff : c'est une
/// URL de partage que l'agence doit pouvoir recopier a tout moment. La
/// protection tient a l'entropie du token (32 octets) et a la revocation.
/// Revocable, regenerable, sans compte cote client (MVP, cf. issue #19).
model PortalLink {
  id         String    @id @default(cuid())
  token      String    @unique
  projectId  String
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Pivot : quel client voit quel projet.
model ClientProject {
  id        String   @id @default(cuid())
  clientId  String
  projectId String
  createdAt DateTime @default(now())

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([clientId, projectId])
  @@index([projectId])
}

enum CommentAuthor {
  AGENCY
  CLIENT
}

enum CredentialKind {
  HOSTING
  DOMAIN
  CMS
  SOCIAL
  ANALYTICS
  OTHER
}

/// Fil de discussion d'une etape. Une note interne n'est jamais servie au portail.
model Comment {
  id         String        @id @default(cuid())
  body       String
  author     CommentAuthor
  authorName String?
  internal   Boolean       @default(false)
  stepId     String
  createdAt  DateTime      @default(now())

  step OnboardingStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
}

/// Fichier depose sur une etape. Le binaire vit hors base (volume disque).
model Asset {
  id               String   @id @default(cuid())
  filename         String
  mimeType         String
  size             Int
  storageKey       String   @unique
  uploadedByClient Boolean  @default(false)
  stepId           String
  createdAt        DateTime @default(now())

  step OnboardingStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
}

/// Acces client. Le secret est chiffre en AES-256-GCM, cle hors base.
model Credential {
  id           String         @id @default(cuid())
  label        String
  kind         CredentialKind @default(OTHER)
  username     String?
  url          String?
  secretCipher String
  secretIv     String
  secretTag    String
  notes        String?
  stepId       String
  createdAt    DateTime       @default(now())

  step      OnboardingStep     @relation(fields: [stepId], references: [id], onDelete: Cascade)
  accessLog CredentialAccess[]

  @@index([stepId])
}

/// Journal des revelations de secret : qui a lu quoi, et quand.
model CredentialAccess {
  id           String   @id @default(cuid())
  credentialId String
  userId       String
  at           DateTime @default(now())

  credential Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId])
}

model OnboardingStep {
  id          String     @id @default(cuid())
  title       String
  description String?
  kind        StepKind   @default(OTHER)
  status      StepStatus @default(PENDING)
  position    Int        @default(0)
  projectId   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments    Comment[]
  assets      Asset[]
  credentials Credential[]

  @@index([projectId])
}
