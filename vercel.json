{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["cdg1"],
  "buildCommand": "node scripts/vercel-build.mjs",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "develop": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 6 * * *"
    }
  ],
  "ignoreCommand": "bash -c '[ \"$VERCEL_GIT_COMMIT_REF\" != \"develop\" ]'"
}
